{
  "name": "qrify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite --host",
    "build": "vite build",
    "preview": "NODE_ENV=production bun run ./server.ts",
    "preview-static": "vite preview",
    "lint": "prettier --check .; eslint .; tsc --noEmit;",
    "lint:fix": "prettier --write .; eslint --fix .; tsc --noEmit;",
    "format": "prettier --write .",
    "update": "bunx npm-check-updates --interactive --format group"
  },
  "dependencies": {
    "@ark-ui/solid": "^4.10.1",
    "@hono/node-server": "^1.13.8",
    "@intosoft/qrcode": "^0.1.4",
    "@paulmillr/qr": "^0.3.0",
    "@tailwindcss/vite": "^4.0.3",
    "clsx": "^2.1.1",
    "hono": "^4.6.20",
    "html-to-image": "^1.11.11",
    "nanoid": "^5.0.9",
    "solid-js": "^1.9.4",
    "solid-qr-code": "^0.1.11",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.0.3",
    "tippy.js": "^6.3.7",
    "vanilla-colorful": "^0.7.2",
    "vike": "0.4.220",
    "vike-metadata-solid": "^1.0.4",
    "vike-solid": "^0.7.8"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.18.1",
    "@types/bun": "^1.2.2",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "@vercel/node": "^5.1.0",
    "eslint": "^9.19.0",
    "eslint-plugin-solid": "^0.14.5",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-solid": "^2.11.0",
    "vite-plugin-solid-svg": "^0.8.1"
  }
}
